@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix epp:   <http://lv2plug.in/ns/ext/port-props#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
<https://faustlv2.bitbucket.io/whammy_v1>
       a lv2:Plugin ;
       doap:name "Whammy V1 inspired" ;
       lv2:binary <whammy_v1.so> ;
       lv2:requiredFeature urid:map ;
       lv2:optionalFeature epp:supportsStrictBounds ;
       lv2:optionalFeature lv2:hardRTCapable ;
       doap:maintainer [ foaf:name "GitHub Copilot" ] ;
       doap:revision "1.0" ;
       doap:license "MIT" ;
    lv2:port [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 0 ;
	lv2:symbol "Drive_0" ;
	lv2:name "Drive" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 100 ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 1 ;
	lv2:symbol "Expression_Pedal_1" ;
	lv2:name "Expression Pedal" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 1999 ;
	lv2:default 0 ;
	lv2:minimum -1 ;
	lv2:maximum 1 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 2 ;
	lv2:symbol "Manual_Pitch_2" ;
	lv2:name "Manual Pitch" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 240 ;
	lv2:default 0 ;
	lv2:minimum -12 ;
	lv2:maximum 12 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 3 ;
	lv2:symbol "Mode_3" ;
	lv2:name "Mode" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 4 ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 4 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 4 ;
	lv2:symbol "Output_4" ;
	lv2:name "Output" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 200 ;
	lv2:default 0.8 ;
	lv2:minimum 0 ;
	lv2:maximum 2 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 5 ;
	lv2:symbol "Range_5" ;
	lv2:name "Range" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 200 ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 2 ;
    ] , [
	a lv2:InputPort ;
	a lv2:ControlPort ;
	lv2:index 6 ;
	lv2:symbol "Wet_6" ;
	lv2:name "Wet" ;
        lv2:portProperty epp:hasStrictBounds ;
        epp:rangeSteps 100 ;
	lv2:default 0.75 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
    ] , [
	a lv2:InputPort ;
	a lv2:AudioPort ;
	lv2:index 7 ;
	lv2:symbol "in0" ;
	lv2:name "in0" ;
    ] , [
	a lv2:InputPort ;
	a lv2:AudioPort ;
	lv2:index 8 ;
	lv2:symbol "in1" ;
	lv2:name "in1" ;
    ] , [
	a lv2:OutputPort ;
	a lv2:AudioPort ;
	lv2:index 9 ;
	lv2:symbol "out0" ;
	lv2:name "out0" ;
    ] , [
	a lv2:OutputPort ;
	a lv2:AudioPort ;
	lv2:index 10 ;
	lv2:symbol "out1" ;
	lv2:name "out1" ;
    ]
.
